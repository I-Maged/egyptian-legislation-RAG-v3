# Copy to .env and fill in — NEVER commit .env (gitignored) and NEVER bake
# these values into the Docker image. Usage:
#
#   cp .env.example .env
#   docker compose up --build -d

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=postgres
# URL-safe only (no @ : / ? #) — it is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=egyptian_law_rag_v3

# --- Web --------------------------------------------------------------------
WEB_PORT=3000
# Required in production. Generate one:  openssl rand -hex 32
AUTH_SECRET=

# --- Ollama (EXTERNAL, not containerized) -----------------------------------
# From inside Docker, `localhost` means the web container itself, so point at
# the host/LAN Ollama server instead:
#   Windows/Mac: http://host.docker.internal:11434
#   Linux:       http://host.docker.internal:11434 (mapped via extra_hosts)
#                or your LAN IP, e.g. http://192.168.1.50:11434
OLLAMA_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
# Local default: `ollama pull gemma4` (no signin). Cloud alternative
# `gemma4:cloud` needs `ollama signin` + internet and can be retired.
GENERATION_MODEL=gemma4
