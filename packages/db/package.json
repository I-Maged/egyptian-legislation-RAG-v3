{
  "name": "@egyptian-law/db",
  "version": "1.0.0",
  "description": "Database layer for Egyptian Legislation RAG",
  "license": "ISC",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
