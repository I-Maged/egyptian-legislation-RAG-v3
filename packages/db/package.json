    "bmsearch": "tsx src/repositories/bm25.repository.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.23.0"
