{
  "name": "Egyptian Legislation RAG",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run prisma:generate --workspace @egyptian-law/db",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "recover": "npm run build && node dist/index.js",
    "test": "vitest",
    "ragas:dataset": "tsx packages/evaluation/src/ragas/export.ts",
    "ragas:evaluate": "python evaluation/ragas/run.py",
    "ragas:diagnose-faithfulness": "python evaluation/ragas/faithfulness-diagnostic.py",
    "ragas:inspect-faithfulness": "python evaluation/ragas/inspect-faithfulness.py",
    "parse:law": "tsx packages/ingestion/src/parser/index.ts",
    "test:parser": "vitest run --config packages/ingestion/vitest.config.ts",
    "test:rag": "vitest run packages/rag/src",
    "rag:smoke:labour": "npm --workspace @egyptian-law/rag run smoke:labour",
    "rag:smoke:financial": "npm --workspace @egyptian-law/rag run smoke:financial",
    "rag:smoke:personal": "npm --workspace @egyptian-law/rag run smoke:personal",
    "rag:smoke:all": "npm run rag:smoke:labour && npm run rag:smoke:financial && npm run rag:smoke:personal",
    "retrieval:benchmarks": "npm --workspace @egyptian-law/evaluation run retrieval-benchmarks",
    "evaluation:benchmark": "vitest run packages/evaluation/src/benchmarks/law-generation-benchmark.test.ts",
    "evaluation:financial": "set RUN_LAW_GENERATION_BENCHMARK=1&& set EVALUATION_LAW=financial&& vitest run packages/evaluation/src/benchmarks/law-generation-benchmark.test.ts",
    "evaluation:personal": "set RUN_LAW_GENERATION_BENCHMARK=1&& set EVALUATION_LAW=personal-affairs&& vitest run packages/evaluation/src/benchmarks/law-generation-benchmark.test.ts",
    "ragas:dataset:financial": "tsx packages/evaluation/src/ragas/export.ts --law financial",
    "ragas:dataset:personal": "tsx packages/evaluation/src/ragas/export.ts --law personal-affairs",
    "ragas:evaluate:financial": "python evaluation/ragas/run.py --law financial",
    "ragas:evaluate:personal": "python evaluation/ragas/run.py --law personal-affairs",
    "ragas:diagnose:financial": "python evaluation/ragas/faithfulness-diagnostic.py --law financial",
    "ragas:diagnose:personal": "python evaluation/ragas/faithfulness-diagnostic.py --law personal-affairs",
    "ragas:inspect:financial": "python evaluation/ragas/inspect-faithfulness.py --law financial",
    "ragas:inspect:personal": "python evaluation/ragas/inspect-faithfulness.py --law personal-affairs",
    "evaluation:financial:full": "npm run evaluation:financial && npm run ragas:dataset:financial && npm run ragas:evaluate:financial && npm run ragas:diagnose:financial && npm run ragas:inspect:financial",
    "evaluation:personal:full": "npm run evaluation:personal && npm run ragas:dataset:personal && npm run ragas:evaluate:personal && npm run ragas:diagnose:personal && npm run ragas:inspect:personal"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.74",
    "ollama": "^0.5.18",
    "pdfjs-dist": "^5.4.149"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
